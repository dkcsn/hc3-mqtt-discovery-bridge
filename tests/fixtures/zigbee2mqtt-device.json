{
  "topic": "homeassistant/device/kitchen_multisensor/config",
  "payload": {
    "dev": {"ids": "0x00158d0001", "name": "Kitchen multisensor", "mf": "Example", "mdl": "THB"},
    "o": {"name": "Zigbee2MQTT-like fixture", "sw": "2.0"},
    "state_topic": "zigbee2mqtt/kitchen_multisensor",
    "cmps": {
      "temperature": {"p": "sensor", "dev_cla": "temperature", "unit_of_meas": "°C", "uniq_id": "kitchen_temperature", "val_tpl": "{{ value_json.temperature }}"},
      "humidity": {"p": "sensor", "dev_cla": "humidity", "unit_of_meas": "%", "uniq_id": "kitchen_humidity", "val_tpl": "{{ value_json.humidity }}"},
      "battery": {"p": "sensor", "dev_cla": "battery", "unit_of_meas": "%", "uniq_id": "kitchen_battery", "val_tpl": "{{ value_json.battery }}"}
    }
  }
}
